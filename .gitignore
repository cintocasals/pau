.pau/.staging/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Eval output
results/

# The packaged plugin goes to the GitHub release, not into the repo:
# an install should not carry a copy of itself.
dist/
